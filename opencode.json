    {
      "action": "external_directory",
      "resource": "~/.rustup/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/bin/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
