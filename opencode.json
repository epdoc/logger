      "action": "shell",
      "resource": "rustup toolchain list*",
      "effect": "allow"
    },
    { "action": "shell", "resource": "rustup target list*", "effect": "allow" },
    { "action": "shell", "resource": "rustup component add*", "effect": "ask" },
