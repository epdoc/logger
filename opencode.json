    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*", "effect": "allow" },

    {
      "action": "external_directory",
      "resource": "~/dev/@epdoc/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/dev/@jpravetz/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/dev/rust/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/opencode/**",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.cargo/**",
      "effect": "allow"
