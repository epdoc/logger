{
  "name": "@epdoc/cliapp-template",
  "version": "0.0.43",
  "description": "Template for creating @epdoc/cliapp compatible commands",
  "exports": {
    ".": "./src/mod.ts",
    "./main": "./main.ts"
  },
  "tasks": {
    "fmt": "deno fmt src test *.ts *.json",
    "lint": "deno lint src test",
    "check": "deno check *.ts *.json src test",
    "test": "deno test -A test",
    "run": "deno run -A ./main.ts",
    "docs": "deno doc --json src/mod.ts > library-docs.json",
    "ok": "deno fmt && deno task lint && deno task check && deno task test && deno task docs"
  },
  "license": "MIT",
  "imports": {
    "@epdoc/cliapp": "jsr:@epdoc/cliapp@^2.3.3",
    "@epdoc/logger": "jsr:@epdoc/logger@^1003.3.72",
    "@epdoc/progress": "jsr:@epdoc/progress@^0.1.15",
    "@epdoc/type": "jsr:@epdoc/type@^2.0.2",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/fmt": "jsr:@std/fmt@^1.0.10"
  },
  "fmt": {
    "singleQuote": true,
    "lineWidth": 120,
    "include": [
      "src",
      "test",
      "main.ts",
      "*.json"
    ]
  },
  "lint": {
    "include": [
      "src",
      "test",
      "main.ts",
      "*.json"
    ]
  }
}
