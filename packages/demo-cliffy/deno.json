{
  "name": "@epdoc/demo-cliffy",
  "version": "0.0.5",
  "exports": "./main.ts",
  "imports": {
    "@cliffy/command": "jsr:@jpravetz/command@1.0.0-rc.9-fix.2",
    "@epdoc/logger": "jsr:@epdoc/logger@^1003.2.8",
    "@epdoc/msgbuilder": "jsr:@epdoc/msgbuilder@^0.1.0",
    "@std/fmt": "jsr:@std/fmt@^1.0.8"
  },
  "tasks": {
    "test": "deno test -A",
    "lint": "deno lint",
    "check": "deno check src",
    "run": "deno run -A ./main.ts",
    "docs": "deno doc --json src/mod.ts > library-docs.json",
    "update": "output=$(deno update 2>&1); echo \"$output\"; [[ \"$output\" =~ \"Updated\" ]]",
    "update:changed": "deno task update && deno task prepublish",
    "prepublish": "deno fmt && deno task lint && deno task check && deno task test && deno task docs"
  },
  "lint": {
    "include": [
      "src"
    ]
  },
  "fmt": {
    "singleQuote": true,
    "lineWidth": 120,
    "include": [
      "src"
    ]
  }
}
