{
  "name": "@epdoc/logger-examples",
  "version": "0.0.1-alpha.19",
  "exports": "./README.md",
  "description": "Logging module with chainable formatting, middleware mixins and extendable transports",
  "author": {
    "name": "James Pravetz",
    "email": "jpravetz@epdoc.com"
  },
  "license": "MIT",
  "tasks": {
    "lint": "deno lint",
    "check": "deno check *.ts test/*.ts",
    "test": "deno test -A",
    "examples": "./run.sh"
  },
  "test": {
    "include": [
      "test/**/*.test.ts"
    ]
  },
  "lint": {
    "include": [
      "deno.json",
      "*.ts",
      "test"
    ]
  },
  "fmt": {
    "include": [
      "*.ts",
      "test",
      "deno.json"
    ],
    "singleQuote": true,
    "lineWidth": 120
  },
  "imports": {
    "@epdoc/cliapp": "../cliapp/src/mod.ts",
    "@epdoc/logger": "../logger/src/mod.ts",
    "@epdoc/msgbuilder": "../msgbuilder/src/mod.ts",
    "@epdoc/progress": "jsr:@epdoc/progress@^0.0.9",
    "@epdoc/type": "jsr:@epdoc/type@^1.2.6",
    "@std/expect": "jsr:@std/expect@^1.0.18",
    "@std/testing": "jsr:@std/testing@^1.0.17"
  }
}
