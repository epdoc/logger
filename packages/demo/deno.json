{
  "name": "@epdoc/demo",
  "version": "0.0.17",
  "description": "Demo CliApp demo project",
  "author": {
    "name": "James Pravetz",
    "email": "jpravetz@epdoc.com"
  },
  "license": "MIT",
  "tasks": {
    "fmt": "deno fmt src test *.ts *.json",
    "lint": "deno lint *.ts *.json src test",
    "check": "deno check *.ts *.json src test",
    "test": "deno test --allow-all",
    "run": "deno run -A ./main.ts",
    "docs": "deno doc --json src/mod.ts > library-docs.json",
    "ok": "deno fmt && deno task lint && deno task check && deno task test && deno task docs",
    "install": "deno install --global -A -f --config deno.json --name cliapp-demo main.ts"
  },
  "exports": "./main.ts",
  "lint": {
    "include": [
      "src",
      "test",
      "main.ts",
      "deno.json"
    ]
  },
  "fmt": {
    "include": [
      "src",
      "test",
      "main.ts",
      "deno.json"
    ],
    "singleQuote": true,
    "lineWidth": 120
  },
  "imports": {
    "@epdoc/cliapp": "file:../cliapp/src/mod.ts",
    "@epdoc/fs": "jsr:@epdoc/fs@^1.3.5",
    "@epdoc/logger": "file:../logger/src/mod.ts",
    "@epdoc/loglevels": "file:../loglevels/src/mod.ts",
    "@epdoc/msgbuilder": "file:../msgbuilder/src/mod.ts",
    "@epdoc/type": "jsr:@epdoc/type@^1.2.11",
    "@std/assert": "jsr:@std/assert@^1.0.19"
  }
}
