{
  "name": "@epdoc/cliapp",
  "description": "A CLI application template for @epdoc/logger",
  "version": "2.1.19",
  "exports": "./src/mod.ts",
  "publish": {
    "include": [
      "src",
      "deno.json",
      "README.md",
      "library-metadata.json"
    ]
  },
  "tasks": {
    "fmt": "deno fmt src test *.json",
    "lint": "deno lint src test/*.test.ts",
    "check": "deno check src test/*.test.ts",
    "test": "deno test -A test/*.test.ts",
    "docs": "deno doc --json src/mod.ts > library-docs.json",
    "ok": "deno fmt && deno task lint && deno task check && deno task test && deno task docs",
    "dev": "deno test --watch",
    "example:01": "deno run -A test/example.01.test.ts",
    "example:02": "deno run -A test/example.02.test.ts",
    "example:03": "deno run -A test/example.03.test.ts",
    "example:04": "deno run -A test/example.04.test.ts"
  },
  "license": "MIT",
  "imports": {
    "@epdoc/logger": "jsr:@epdoc/logger@^1003.3.10",
    "@epdoc/loglevels": "jsr:@epdoc/loglevels@^1.0.1",
    "@epdoc/msgbuilder": "jsr:@epdoc/msgbuilder@^0.1.19",
    "@epdoc/progress": "jsr:@epdoc/progress@^0.1.1",
    "@epdoc/type": "jsr:@epdoc/type@^1.2.8",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/expect": "jsr:@std/expect@^1.0.18",
    "@std/fmt/colors": "jsr:@std/fmt@^1.0.9/colors",
    "@std/testing": "jsr:@std/testing@^1.0.17",
    "commander": "npm:commander@^14.0.3"
  },
  "lint": {
    "include": [
      "src",
      "test/*.ts",
      "mod.ts",
      "*.json"
    ]
  },
  "fmt": {
    "singleQuote": true,
    "lineWidth": 120,
    "include": [
      "src",
      "test",
      "*.json",
      "*.md"
    ]
  }
}
