{
  "name": "@epdoc/logger",
  "version": "1003.3.11",
  "description": "Logging module with chainable formatting, middleware mixins and extendable transports",
  "author": {
    "name": "James Pravetz",
    "email": "jpravetz@epdoc.com"
  },
  "license": "MIT",
  "tasks": {
    "fmt": "deno fmt src test *.json",
    "lint": "deno lint",
    "check": "deno check src test",
    "test": "deno test -A",
    "docs": "deno doc --json src/mod.ts > library-docs.json",
    "ok": "deno fmt && deno task lint && deno task check && deno task test && deno task docs",
    "publish": "deno publish"
  },
  "exports": "./src/mod.ts",
  "publish": {
    "include": [
      "src",
      "deno.json",
      "README.md",
      "library-metadata.json"
    ]
  },
  "test": {
    "include": [
      "src/**/*test.ts",
      "test/**/*test.ts"
    ]
  },
  "lint": {
    "include": [
      "src",
      "test"
    ],
    "exclude": [
      "test/archive"
    ]
  },
  "fmt": {
    "include": [
      "src",
      "test",
      "deno.json"
    ],
    "singleQuote": true,
    "lineWidth": 120
  },
  "imports": {
    "$log": "./src/types.ts",
    "$logger": "./src/loggers/mod.ts",
    "$transport": "./src/transports/mod.ts",
    "@epdoc/loglevels": "jsr:@epdoc/loglevels@^1.0.1",
    "@epdoc/msgbuilder": "jsr:@epdoc/msgbuilder@^0.1.19",
    "@std/expect": "jsr:@std/expect@^1.0.18",
    "@std/fmt/colors": "jsr:@std/fmt@^1.0.9/colors",
    "@epdoc/type": "jsr:@epdoc/type@^1.2.11",
    "@epdoc/string": "jsr:@epdoc/string@^0.1.28",
    "@epdoc/duration": "jsr:@epdoc/duration@^0.3.10",
    "@epdoc/datetime": "jsr:@epdoc/datetime@^3.2.6",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing": "jsr:@std/testing@^1.0.17"
  }
}
