{
  "name": "@epdoc/logger",
  "version": "1003.3.7",
  "description": "Logging module with chainable formatting, middleware mixins and extendable transports",
  "author": {
    "name": "James Pravetz",
    "email": "jpravetz@epdoc.com"
  },
  "license": "MIT",
  "tasks": {
    "test": "deno test -A",
    "lint": "deno lint",
    "check": "deno check src test",
    "docs": "deno doc --json src/mod.ts > library-docs.json",
    "prepublish": "deno fmt && deno task lint && deno task check && deno task test && deno task docs",
    "publish": "deno publish",
    "update": "output=$(deno update 2>&1); echo \"$output\"; [[ \"$output\" =~ \"Updated\" ]]",
    "update:changed": "deno task update && deno task prepublish",
    "fmt": "deno fmt src test *.json"
  },
  "exports": "./src/mod.ts",
  "test": {
    "include": [
      "src/**/*test.ts",
      "test/**/*test.ts"
    ]
  },
  "lint": {
    "include": [
      "src",
      "test"
    ],
    "exclude": [
      "test/archive"
    ]
  },
  "fmt": {
    "include": [
      "src",
      "test",
      "deno.json"
    ],
    "singleQuote": true,
    "lineWidth": 120
  },
  "imports": {
    "$log": "./src/types.ts",
    "$logger": "./src/loggers/mod.ts",
    "$transport": "./src/transports/mod.ts",
    "@epdoc/loglevels": "jsr:@epdoc/loglevels@^1.0.0",
    "@epdoc/msgbuilder": "jsr:@epdoc/msgbuilder@^0.1.14",
    "@std/expect": "jsr:@std/expect@^1.0.18",
    "@std/fmt": "jsr:@std/fmt@^1.0.9",
    "@std/fmt/colors": "jsr:@std/fmt@^1.0.9/colors",
    "@epdoc/type": "jsr:@epdoc/type@^1.2.6",
    "@epdoc/string": "jsr:@epdoc/string@^0.1.24",
    "@epdoc/duration": "jsr:@epdoc/duration@^0.3.7",
    "@epdoc/datetime": "jsr:@epdoc/datetime@^3.2.3",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing": "jsr:@std/testing@^1.0.17"
  }
}
