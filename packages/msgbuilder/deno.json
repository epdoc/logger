{
  "name": "@epdoc/msgbuilder",
  "version": "0.1.4",
  "description": "Message builder module with chainable formatting",
  "author": {
    "name": "James Pravetz",
    "email": "jpravetz@epdoc.com"
  },
  "license": "MIT",
  "tasks": {
    "test": "deno test -A",
    "lint": "deno lint",
    "check": "deno check src test deno.json",
    "docs": "deno doc --json src/mod.ts > library-docs.json",
    "prepublish": "deno fmt && deno task lint && deno task check && deno task test && deno task docs",
    "publish": "deno publish",
    "update": "output=$(deno update 2>&1); echo \"$output\"; [[ \"$output\" =~ \"Updated\" ]]",
    "update:changed": "deno task update && deno task prepublish"
  },
  "exports": "./src/mod.ts",
  "test": {
    "include": [
      "./src/**/*test.ts",
      "./test/**/*test.ts"
    ]
  },
  "lint": {
    "include": [
      "./src",
      "./test",
      "deno.json"
    ]
  },
  "fmt": {
    "include": [
      "./src",
      "./test",
      "deno.json"
    ],
    "singleQuote": true,
    "lineWidth": 120
  },
  "imports": {
    "@epdoc/duration": "jsr:@epdoc/duration@^0.3.7",
    "@std/expect": "jsr:@std/expect@^1.0.17",
    "@std/fmt/colors": "jsr:@std/fmt@^1.0.9/colors",
    "@epdoc/type": "jsr:@epdoc/type@^1.2.6",
    "@epdoc/string": "jsr:@epdoc/string@^0.1.16",
    "@std/assert": "jsr:@std/assert@^1.0.18",
    "@std/testing": "jsr:@std/testing@^1.0.17"
  }
}
