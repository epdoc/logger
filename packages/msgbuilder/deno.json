{
  "name": "@epdoc/msgbuilder",
  "version": "0.1.61",
  "description": "Message builder module with chainable formatting",
  "author": {
    "name": "James Pravetz",
    "email": "jpravetz@epdoc.com"
  },
  "license": "MIT",
  "tasks": {
    "fmt": "deno fmt src test *.json",
    "lint": "deno lint",
    "check": "deno check src test deno.json",
    "test": "deno test -A",
    "docs": "deno doc --json src/mod.ts > library-docs.json",
    "ok": "deno fmt && deno task lint && deno task check && deno task test && deno task docs",
    "publish": "deno publish"
  },
  "exports": "./src/mod.ts",
  "publish": {
    "include": [
      "src",
      "deno.json",
      "README.md",
      "library-metadata.json"
    ]
  },
  "test": {
    "include": [
      "./src/**/*test.ts",
      "./test/**/*test.ts"
    ]
  },
  "lint": {
    "include": [
      "./src",
      "./test",
      "deno.json"
    ]
  },
  "fmt": {
    "include": [
      "./src",
      "./test",
      "deno.json"
    ],
    "singleQuote": true,
    "lineWidth": 120
  },
  "imports": {
    "@epdoc/colors": "jsr:@epdoc/colors@^1.1.2",
    "@epdoc/datetime": "jsr:@epdoc/datetime@^4.2.4",
    "@epdoc/duration": "jsr:@epdoc/duration@^0.3.21",
    "@epdoc/fmt": "jsr:@epdoc/fmt@^1.0.16",
    "@std/expect": "jsr:@std/expect@^1.0.19",
    "@std/fmt/colors": "jsr:@std/fmt@^1.0.10/colors",
    "@epdoc/type": "jsr:@epdoc/type@^2.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing": "jsr:@std/testing@^1.0.19"
  }
}
