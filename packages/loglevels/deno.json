{
  "name": "@epdoc/loglevels",
  "version": "1.0.6",
  "description": "Log levels",
  "author": {
    "name": "James Pravetz",
    "email": "jpravetz@epdoc.com"
  },
  "license": "MIT",
  "tasks": {
    "fmt": "deno fmt src test *.json",
    "lint": "deno lint",
    "check": "deno check src test",
    "test": "deno test -A",
    "docs": "deno doc --json src/mod.ts > library-docs.json",
    "ok": "deno fmt && deno task lint && deno task check && deno task test && deno task docs",
    "publish": "deno publish"
  },
  "exports": "./src/mod.ts",
  "publish": {
    "include": [
      "src",
      "deno.json",
      "README.md",
      "library-metadata.json"
    ]
  },
  "test": {
    "include": [
      "./src/**/*test.ts",
      "./test/**/*test.ts"
    ]
  },
  "lint": {
    "include": [
      "./src",
      "./test/**/*test.ts"
    ]
  },
  "fmt": {
    "include": [
      "./src",
      "./test/**/*test.ts",
      "deno.json"
    ],
    "singleQuote": true,
    "lineWidth": 120
  },
  "imports": {
    "@epdoc/type": "jsr:@epdoc/type@^1.2.13",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/fmt": "jsr:@std/fmt@^1.0.10",
    "@std/testing": "jsr:@std/testing@^1.0.18"
  }
}
